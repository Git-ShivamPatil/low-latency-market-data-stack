<?xml version="1.0" encoding="UTF-8"?>
<!--
  The single source of truth for the wire layout of this stack.

  Everything on the wire is generated from this file: the Rust codec
  (crates/wire/src/generated.rs), the C++ header (cpp/wire/include/wire/generated.hpp)
  and the golden byte vectors (schema/golden/*.bin). Nothing hand-writes a field
  offset anywhere else in the repo. Run `make codegen` after editing this file;
  CI fails if the committed generated files do not match what this schema produces.

  Encoding is SBE-flavoured rather than SBE-conformant: fixed little-endian blocks,
  an 8-byte message header, and one repeating group. See docs/WIRE.md for the exact
  byte layouts and for what is deliberately not implemented.

  Two framing layers:

    datagram := packetHeader , message*
    message  := messageHeader , rootBlock , group?

  A message carries no sequence number of its own. The sequence of message i in a
  datagram is packetHeader.firstSequence + i. That is what makes batching cheap:
  at 16-32 messages per datagram the per-message framing cost is 8 bytes and the
  clock is read once per datagram rather than once per message.
-->
<messageSchema package="mdstack.wire"
               id="1"
               version="1"
               semanticVersion="1.0.0"
               byteOrder="littleEndian"
               description="Market data feed for the low-latency market data and order entry stack">

  <types>
    <!-- Prices are fixed-point integers. A price field holds the value scaled by
         10^-priceExponent, so 101.2500 is encoded as 1012500. There is no
         floating point anywhere on the wire. -->
    <constant name="priceExponent" value="-4"/>

    <!-- Per-datagram header. Written once per datagram, ahead of the messages. -->
    <composite name="packetHeader" description="Per-datagram framing">
      <field name="schemaId"        type="uint16" offset="0"  description="Must equal the schema id; a mismatch is a hard reject"/>
      <field name="version"         type="uint16" offset="2"  description="Schema version the publisher encoded with"/>
      <field name="messageCount"    type="uint16" offset="4"  description="Number of messages packed into this datagram"/>
      <field name="channel"         type="uint8"  offset="6"  description="0 = feed A, 1 = feed B; diagnostic only, arbitration keys on sequence"/>
      <field name="flags"           type="uint8"  offset="7"  description="bit0 = this datagram is part of a snapshot cycle"/>
      <field name="firstSequence"   type="uint64" offset="8"  description="Sequence of the first message; message i is firstSequence + i"/>
      <field name="sendTimestampNs" type="uint64" offset="16" description="Publisher clock at send, nanoseconds since the Unix epoch"/>
    </composite>

    <!-- Per-message header. Standard SBE shape: blockLength, templateId, schemaId, version. -->
    <composite name="messageHeader" description="Per-message framing">
      <field name="blockLength" type="uint16" offset="0" description="Bytes of root block following this header, excluding any group"/>
      <field name="templateId"  type="uint16" offset="2" description="Which message this is"/>
      <field name="schemaId"    type="uint16" offset="4"/>
      <field name="version"     type="uint16" offset="6"/>
    </composite>

    <!-- Repeating-group header. -->
    <composite name="groupSizeEncoding" description="Repeating-group framing">
      <field name="blockLength" type="uint16" offset="0" description="Bytes per group entry"/>
      <field name="numInGroup"  type="uint16" offset="2" description="Number of entries"/>
    </composite>

    <!--
      Order path only. The header of an SPSC shared-memory ring.

      Deliberately gets layout constants and no decoder. Reading writeIndex
      through an ordinary accessor is exactly the race this design exists to
      avoid: the index has to be loaded with acquire ordering and stored with
      release ordering, and a plain field read gives neither. Each language
      writes its own atomic access over these offsets. See docs/ORDER-PATH.md.

      The three 64-byte regions are the whole point. The producer writes
      writeIndex and the consumer writes readIndex; sharing a cache line
      between them makes every write invalidate the other core's copy, which
      leaves the queue correct and several times slower for no visible reason.
    -->
    <composite name="ringHeader" description="SPSC shared-memory ring header">
      <!-- Region 1: written once at creation, read-only thereafter. -->
      <field name="magic"     type="uint64" offset="0"  description="Identifies the file as a ring; a mismatch is a hard refusal, not a guess"/>
      <field name="version"   type="uint32" offset="8"  description="Ring layout version, separate from the schema version"/>
      <field name="slotSize"  type="uint32" offset="12" description="Bytes per slot, including the length prefix"/>
      <field name="capacity"  type="uint32" offset="16" description="Slots; always a power of two so index-to-slot is a mask"/>
      <field name="reserved"  type="uint32" offset="20"/>
      <field name="reserved2" type="uint64" offset="24"/>
      <field name="reserved3" type="uint64" offset="32"/>
      <field name="reserved4" type="uint64" offset="40"/>
      <field name="reserved5" type="uint64" offset="48"/>
      <field name="reserved6" type="uint64" offset="56"/>
      <!-- Region 2: the producer's, and nobody else's. -->
      <field name="writeIndex" type="uint64" offset="64" description="Free-running count of slots published; never wrapped"/>
      <field name="reserved7"  type="uint64" offset="72"/>
      <field name="reserved8"  type="uint64" offset="80"/>
      <field name="reserved9"  type="uint64" offset="88"/>
      <field name="reserved10" type="uint64" offset="96"/>
      <field name="reserved11" type="uint64" offset="104"/>
      <field name="reserved12" type="uint64" offset="112"/>
      <field name="reserved13" type="uint64" offset="120"/>
      <!-- Region 3: the consumer's, and nobody else's. -->
      <field name="readIndex"  type="uint64" offset="128" description="Free-running count of slots consumed; write minus read is the depth"/>
      <field name="reserved14" type="uint64" offset="136"/>
      <field name="reserved15" type="uint64" offset="144"/>
      <field name="reserved16" type="uint64" offset="152"/>
      <field name="reserved17" type="uint64" offset="160"/>
      <field name="reserved18" type="uint64" offset="168"/>
      <field name="reserved19" type="uint64" offset="176"/>
      <field name="reserved20" type="uint64" offset="184"/>
    </composite>

    <!--
      Order path only. The per-slot prefix. A slot holds this then the message,
      padded out to slotSize. The length is what tells the consumer how many of
      the slot's bytes are real, and it is written before the release store that
      publishes the slot.
    -->
    <composite name="ringSlot" description="Per-slot framing inside an SPSC ring">
      <field name="length"    type="uint32" offset="0" description="Bytes of message in this slot"/>
      <field name="reserved"  type="uint32" offset="4"/>
    </composite>

    <enum name="Side" encodingType="uint8">
      <validValue name="Bid">0</validValue>
      <validValue name="Ask">1</validValue>
    </enum>

    <enum name="ModifyReason" encodingType="uint8">
      <!-- Reduce keeps the place in the price-time queue; Replace loses it.
           The book code depends on this distinction, so it is on the wire rather
           than inferred from whether the quantity went down. -->
      <validValue name="Reduce">0</validValue>
      <validValue name="Replace">1</validValue>
    </enum>

    <!-- Order path only. What happened to an order, in the sense FIX's
         ExecType (150) means it: one message type reports acknowledgement,
         fills, cancels, rejects and status, because they all answer the same
         question about the same order. -->
    <enum name="ExecType" encodingType="uint8">
      <validValue name="Acknowledged">0</validValue>
      <validValue name="PartialFill">1</validValue>
      <validValue name="Fill">2</validValue>
      <validValue name="Canceled">3</validValue>
      <validValue name="Rejected">4</validValue>
      <!-- The two reconciliation forms: one line per open order the engine
           holds, then a marker carrying how many there were. -->
      <validValue name="OrderStatus">5</validValue>
      <validValue name="StatusComplete">6</validValue>
    </enum>

    <!-- Order path only. Why an order was refused. NotRejected is the value
         every non-reject carries; it is named rather than left as an implicit
         zero so that a reader of a hex dump does not have to guess. -->
    <enum name="RejectReason" encodingType="uint8">
      <validValue name="NotRejected">0</validValue>
      <validValue name="UnknownSymbol">1</validValue>
      <validValue name="MaxOrderQuantity">2</validValue>
      <validValue name="MaxNotional">3</validValue>
      <validValue name="PriceCollar">4</validValue>
      <validValue name="OpenOrderLimit">5</validValue>
      <validValue name="PositionLimit">6</validValue>
      <validValue name="DuplicateClientOrderId">7</validValue>
      <validValue name="UnknownOrder">8</validValue>
      <!-- The ring was full. Rejecting is the only honest answer: blocking
           stalls the FIX session and dropping loses an order silently. -->
      <validValue name="QueueFull">9</validValue>
    </enum>
  </types>

  <message name="AddOrder" id="1" blockLength="24"
           description="A new order rests on the book">
    <field name="orderId"  id="1" type="uint64" offset="0"/>
    <field name="price"    id="2" type="int64"  offset="8"  semanticType="Price"/>
    <field name="quantity" id="3" type="uint32" offset="16"/>
    <field name="symbolId" id="4" type="uint16" offset="20"/>
    <field name="side"     id="5" type="Side"   offset="22"/>
    <field name="reserved" id="6" type="uint8"  offset="23"/>
  </message>

  <message name="ModifyOrder" id="2" blockLength="24"
           description="A resting order changes price or quantity">
    <field name="orderId"     id="1" type="uint64"       offset="0"/>
    <field name="newPrice"    id="2" type="int64"        offset="8"  semanticType="Price"/>
    <field name="newQuantity" id="3" type="uint32"       offset="16"/>
    <field name="symbolId"    id="4" type="uint16"       offset="20"/>
    <field name="side"        id="5" type="Side"         offset="22"/>
    <field name="reason"      id="6" type="ModifyReason" offset="23"/>
  </message>

  <message name="DeleteOrder" id="3" blockLength="12"
           description="A resting order leaves the book">
    <field name="orderId"  id="1" type="uint64" offset="0"/>
    <field name="symbolId" id="2" type="uint16" offset="8"/>
    <field name="side"     id="3" type="Side"   offset="10"/>
    <field name="reserved" id="4" type="uint8"  offset="11"/>
  </message>

  <message name="Trade" id="4" blockLength="40"
           description="An aggressing order crossed with a resting order">
    <field name="tradeId"          id="1" type="uint64" offset="0"/>
    <field name="aggressorOrderId" id="2" type="uint64" offset="8"/>
    <field name="restingOrderId"   id="3" type="uint64" offset="16"/>
    <field name="price"            id="4" type="int64"  offset="24" semanticType="Price"/>
    <field name="quantity"         id="5" type="uint32" offset="32"/>
    <field name="symbolId"         id="6" type="uint16" offset="36"/>
    <field name="aggressorSide"    id="7" type="Side"   offset="38"/>
    <field name="reserved"         id="8" type="uint8"  offset="39"/>
  </message>

  <!-- Carries individual ORDERS, not aggregated price levels.
       An aggregate says "three orders total 250 at this price" but not which
       orders, in what queue order, or with what ids - and queue position is the
       whole point of price-time priority, so an aggregated snapshot cannot
       rebuild an order-level book. Per-order entries rebuild both views: the
       aggregated one is derivable by summing, the reverse is not.
       Real exchanges publish both, because at their scale the aggregated feed is
       dramatically smaller. This one does not have that problem.
       ORDERS APPEAR IN QUEUE ORDER. A consumer that re-adds them in the order
       received reproduces price-time priority exactly; that ordering is the
       load-bearing part of this message and is asserted by the recovery tests. -->
  <message name="Snapshot" id="5" blockLength="12"
           description="Full book state for one symbol, consistent as of lastSequence">
    <field name="lastSequence" id="1" type="uint64" offset="0" description="The snapshot reflects every message up to and including this sequence"/>
    <field name="symbolId"     id="2" type="uint16" offset="8"/>
    <field name="flags"        id="3" type="uint8"  offset="10" description="bit0 = last fragment for this symbol in this cycle"/>
    <field name="reserved"     id="4" type="uint8"  offset="11"/>
    <group name="orders" id="10" blockLength="24" description="Resting orders in queue order, best price first within each side">
      <field name="orderId"    id="1" type="uint64" offset="0"/>
      <field name="price"      id="2" type="int64"  offset="8" semanticType="Price"/>
      <field name="quantity"   id="3" type="uint32" offset="16"/>
      <field name="side"       id="4" type="Side"   offset="20"/>
      <field name="reserved"   id="5" type="uint8"  offset="21"/>
      <field name="reserved2"  id="6" type="uint16" offset="22"/>
    </group>
  </message>

  <message name="Heartbeat" id="6" blockLength="8"
           description="Published on an idle channel so a handler can tell quiet from dead">
    <field name="lastSequence" id="1" type="uint64" offset="0" description="Highest sequence published so far on this channel"/>
  </message>

  <message name="SequenceReset" id="7" blockLength="8"
           description="The publisher restarts its sequence; the handler must resynchronise">
    <field name="newSequence" id="1" type="uint64" offset="0" description="The sequence the next message will carry"/>
  </message>

  <!--
    ===================================================================
    The order path. scope="orderPath" rather than the default "feed".
    ===================================================================

    These four never appear on multicast. They travel one per slot in the
    shared-memory rings between the gateway, the risk service and the engine:
    messageHeader then the block, with no packetHeader, because a ring slot is
    already framed and its position already sequences it.

    The generator enforces that rather than trusting this comment. A message
    with scope="orderPath" gets no `PacketWriter` append method in either
    language, so the feed publisher has no way to put an order request on the
    wire, and the packet reader treats its template id as unknown.

    They live in this file rather than a schema of their own so that `Side`
    means the same byte on both wires by construction, and so that both wires
    get the same layout checks: every byte named, padding included, natural
    alignment within the block, and a hand-typed golden vector.

    See docs/ORDER-PATH.md.
  -->

  <message name="NewOrder" id="8" blockLength="24" scope="orderPath"
           description="A client order entering the system: gateway to risk to engine">
    <field name="clientOrderId" id="1" type="uint64" offset="0"  description="The gateway's id for this order; carries FIX ClOrdID's meaning"/>
    <field name="price"         id="2" type="int64"  offset="8"  semanticType="Price"/>
    <field name="quantity"      id="3" type="uint32" offset="16"/>
    <field name="symbolId"      id="4" type="uint16" offset="20"/>
    <field name="side"          id="5" type="Side"   offset="22"/>
    <field name="reserved"      id="6" type="uint8"  offset="23"/>
  </message>

  <message name="CancelOrder" id="9" blockLength="24" scope="orderPath"
           description="Cancel a live order: gateway to risk to engine">
    <field name="clientOrderId"     id="1" type="uint64" offset="0"  description="Identifies this cancel request, not the order"/>
    <field name="origClientOrderId" id="2" type="uint64" offset="8"  description="The order to cancel"/>
    <field name="symbolId"          id="3" type="uint16" offset="16"/>
    <field name="side"              id="4" type="Side"   offset="18"/>
    <field name="reserved"          id="5" type="uint8"  offset="19"/>
    <field name="reserved2"         id="6" type="uint32" offset="20"/>
  </message>

  <message name="ExecReport" id="10" blockLength="48" scope="orderPath"
           description="What happened to an order: engine to risk to gateway, or risk to gateway for a reject">
    <field name="clientOrderId"   id="1"  type="uint64"       offset="0"/>
    <field name="exchangeOrderId" id="2"  type="uint64"       offset="8"  description="The engine's order id; zero when the order never reached it"/>
    <field name="tradeId"         id="3"  type="uint64"       offset="16" description="Zero unless this report is a fill"/>
    <field name="price"           id="4"  type="int64"        offset="24" semanticType="Price" description="Fill price on a fill, order price otherwise"/>
    <field name="quantity"        id="5"  type="uint32"       offset="32" description="This event's quantity: filled on a fill, ordered on an acknowledgement"/>
    <field name="leavesQuantity"  id="6"  type="uint32"       offset="36" description="Still live on the book after this event"/>
    <field name="symbolId"        id="7"  type="uint16"       offset="40"/>
    <field name="side"            id="8"  type="Side"         offset="42"/>
    <field name="execType"        id="9"  type="ExecType"     offset="43"/>
    <field name="rejectReason"    id="10" type="RejectReason" offset="44"/>
    <field name="reserved"        id="11" type="uint8"        offset="45"/>
    <field name="reserved2"       id="12" type="uint16"       offset="46"/>
  </message>

  <message name="ReconcileRequest" id="11" blockLength="16" scope="orderPath"
           description="After a restart: name every order you still hold for me">
    <field name="requestId"  id="1" type="uint64" offset="0" description="Echoed on the StatusComplete that ends the answer"/>
    <field name="reserved"   id="2" type="uint64" offset="8"/>
  </message>

</messageSchema>
