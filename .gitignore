/target
**/*.rs.bk
Cargo.lock.orig

# C++
build/
*.o
*.a

# env
.env
.env.local

# editors
.vscode/
.idea/

# run output: digests, summaries and logs from scripts/smoke.sh and the
# benchmark harness. Reports that get published live in bench/ and docs/, not
# here — anything in results/ is regenerable and machine-specific.
# Anything under results/ is regenerable and machine-specific. Named directories
# rather than a single rule, so a report that is *meant* to be committed has to
# be added deliberately.
/results/*
!/results/.gitkeep
